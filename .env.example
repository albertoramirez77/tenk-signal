# ===========================================================================
# TenK Signal — environment variables
#
# Copy to .env (gitignored) and fill in values. config.py fails fast at
# startup if any *required* var is missing. Comments describe what the value
# is, how to get it, and whether it is required in dev / prod.
# ===========================================================================

# --- Anthropic ----------------------------------------------------------------
# Required everywhere except tests (tests inject a fake client).
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model id for extraction. Defaults to claude-sonnet-4-6 (structured outputs GA).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Hard cap on output tokens per extraction call. Cost guard.
EXTRACTION_MAX_TOKENS=800
# Stable string tagged onto every cache row. Bump when the prompt changes so
# old cached extractions don't pollute new runs. UNIQUE(text_sha256,
# prompt_version, model) enforces this at the DB layer.
PROMPT_VERSION=v1

# --- SEC EDGAR ----------------------------------------------------------------
# SEC requires a descriptive User-Agent with a real contact email. Requests
# without it are throttled or blocked. Format documented at
# https://www.sec.gov/os/accessing-edgar-data — example:
#   "TenK Signal admin@yourdomain.com"
# Replace the placeholder before Phase 4.
# Note: this value has a space in it, so it MUST be quoted to source cleanly.
EDGAR_USER_AGENT="TenK Signal albertoramirezaguiar7@gmail.com"
# Soft rate limit (requests/sec). SEC fair access allows up to 10 rps.
EDGAR_RATE_LIMIT_RPS=8

# --- Database (Supabase Postgres) --------------------------------------------
# Required in all environments. Use the pooled connection string for prod.
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tenk_signal
# Supabase project URL. Only needed if/when we use Supabase client features
# beyond raw Postgres (e.g. storage). Optional today.
SUPABASE_URL=
# Service-role key. NEVER expose to the browser. Optional today; required if
# we adopt the Supabase client.
SUPABASE_SERVICE_KEY=

# --- App auth (API keys) ------------------------------------------------------
# Both required. Long random strings (>= 32 chars). Rotate by setting the new
# value, redeploying, then revoking the old.
# Admin key gates POST /ingest, /extract, /backtest, /evals/run.
APP_API_KEY_ADMIN=
# Viewer key gates GET /signals, /backtest/*, /evals. NEVER ships to the
# browser; lives only in Vercel server-side env (no NEXT_PUBLIC_ prefix).
APP_API_KEY_VIEWER=

# --- Observability ------------------------------------------------------------
# Sentry DSN for backend errors. If unset, Sentry init is a no-op.
SENTRY_DSN=
# Log level: DEBUG / INFO / WARNING / ERROR. Default INFO.
LOG_LEVEL=INFO

# --- Frontend (Next.js) -------------------------------------------------------
# Server-only: the URL of the FastAPI backend. Route handlers proxy to it.
BACKEND_API_URL=http://localhost:8000
# Server-only viewer key, mirrors APP_API_KEY_VIEWER on the Vercel side.
# CI greps to ensure no source file outside lib/server-api.ts references this.
APP_API_KEY_VIEWER_SERVER=
# Public Sentry DSN (browser). The only NEXT_PUBLIC_* var we use.
NEXT_PUBLIC_SENTRY_DSN=
